# AK SHELL — Built-in defaults
# Do NOT edit this file. Override in ~/.config/ak-shell/settings.
# All values can be overridden by exporting the same variable
# BEFORE this file is sourced.

# ── Identity ───────────────────────────────────────
: "${AK_SHELL_VERSION:=0.1.0}"
: "${AK_SHELL_HOME:=$HOME/.ak-shell}"
: "${AK_SHELL_CONFIG_DIR:=$HOME/.config/ak-shell}"

# ── Theme (used from Phase 3 onward) ───────────────
: "${AK_THEME:=cyber}"

# ── Prompt ─────────────────────────────────────────
: "${AK_PROMPT_MODE:=multiline}"    # multiline | singleline | compact
: "${AK_PROMPT_SHOW_USER:=true}"
: "${AK_PROMPT_SHOW_HOST:=false}"   # Termux hostname is always "localhost"
: "${AK_PROMPT_SHOW_GIT:=true}"
: "${AK_PROMPT_SHOW_TIME:=false}"
: "${AK_PROMPT_SHOW_STATUS:=true}"
: "${AK_PROMPT_SHOW_DURATION:=false}"
: "${AK_PROMPT_PATH_MAX_LEN:=25}"   # truncate long paths

# ── Features (toggled per-phase) ───────────────────
: "${AK_ENABLE_SUGGESTIONS:=false}"      # Phase 4
: "${AK_ENABLE_SYNTAX_HIGHLIGHT:=false}" # Phase 4
: "${AK_ENABLE_COMPLETION:=false}"       # Phase 4
: "${AK_ENABLE_BANNER:=true}"            # Phase 2 (on by default)
: "${AK_ENABLE_ANIMATIONS:=false}"       # Phase 3+

# ── History ────────────────────────────────────────
: "${AK_HISTORY_SIZE:=10000}"
: "${AK_HISTORY_FILE:=$HOME/.zsh_history}"
: "${AK_HISTORY_DUPS:=historyignore}"    # ignore | erase | historyignore

# ── Colors (fallback palette, overridden by themes) ─
: "${AK_COLOR_PRIMARY:=cyan}"
: "${AK_COLOR_SUCCESS:=green}"
: "${AK_COLOR_ERROR:=red}"
: "${AK_COLOR_DIM:=240}"
: "${AK_COLOR_ACCENT:=magenta}"

export AK_SHELL_VERSION AK_SHELL_HOME AK_SHELL_CONFIG_DIR
export AK_THEME
export AK_PROMPT_MODE AK_PROMPT_SHOW_USER AK_PROMPT_SHOW_HOST
export AK_PROMPT_SHOW_GIT AK_PROMPT_SHOW_TIME AK_PROMPT_SHOW_STATUS
export AK_PROMPT_SHOW_DURATION AK_PROMPT_PATH_MAX_LEN
export AK_ENABLE_SUGGESTIONS AK_ENABLE_SYNTAX_HIGHLIGHT AK_ENABLE_COMPLETION
export AK_ENABLE_BANNER AK_ENABLE_ANIMATIONS
export AK_HISTORY_SIZE AK_HISTORY_FILE AK_HISTORY_DUPS
export AK_COLOR_PRIMARY AK_COLOR_SUCCESS AK_COLOR_ERROR AK_COLOR_DIM AK_COLOR_ACCENT
