#!/data/data/com.termux/files/usr/bin/bash
# AK SHELL — Main CLI Tool

AK_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" # Will be dynamic in Phase 6
AK_CONFIG_DIR="$HOME/.config/ak-shell"

# Colors for CLI
GREEN='\033[0;32m'
CYAN='\033[0;36m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
RESET='\033[0m'

show_help() {
  echo -e "${CYAN}AK SHELL — Premium Termux Framework${RESET}"
  echo "Usage: ak <command> [options]"
  echo ""
  echo "Commands:"
  echo "  theme       Manage themes (list, set, current)"
  echo "  doctor      Check system health and dependencies"
  echo "  version     Show AK SHELL version"
  echo "  help        Show this help menu"
  echo ""
  echo "Run 'ak' without arguments to open the interactive menu."
}

check_theme() {
  local theme="$1"
  if [[ -f "${AK_HOME}/themes/${theme}.zsh" ]]; then
    return 0
  else
    return 1
  fi
}

theme_cmd() {
  local subcmd="$1"
  local theme="$2"

  case "$subcmd" in
    list)
      echo -e "${CYAN}Available Themes:${RESET}"
      local current=$(grep "AK_THEME=" "$AK_CONFIG_DIR/theme" 2>/dev/null | cut -d'=' -f2)
      for f in "${AK_HOME}/themes"/*.zsh; do
        local t=$(basename "$f" .zsh)
        if [[ "$t" == "$current" ]]; then
          echo -e "  * ${GREEN}${t}${RESET} (active)"
        else
          echo "    $t"
        fi
      done
      ;;
    set)
      if [[ -z "$theme" ]]; then
        echo -e "${RED}Error: Please specify a theme name.${RESET}"
        echo "Example: ak theme set cyber"
        return 1
      fi
      if check_theme "$theme"; then
        mkdir -p "$AK_CONFIG_DIR"
        echo "AK_THEME=$theme" > "$AK_CONFIG_DIR/theme"
        echo -e "Theme set to: ${GREEN}${theme}${RESET}"
        echo -e "${YELLOW}Note: Restart Zsh or run 'source ~/.zshrc' to see changes.${RESET}"
      else
        echo -e "${RED}Error: Theme '$theme' not found.${RESET}"
        echo "Run 'ak theme list' to see available themes."
        return 1
      fi
      ;;
    current)
      local current=$(grep "AK_THEME=" "$AK_CONFIG_DIR/theme" 2>/dev/null | cut -d'=' -f2)
      echo -e "Current Theme: ${GREEN}${current:-cyber}${RESET}"
      ;;
    *)
      echo "Usage: ak theme <list|set|current>"
      ;;
  esac
}

doctor_cmd() {
  echo -e "${CYAN}Running System Diagnostics...${RESET}"
  echo "---------------------------------"
  
  # Check Zsh
  if command -v zsh >/dev/null 2>&1; then
    echo -e "[${GREEN}OK${RESET}] Zsh is installed."
  else
    echo -e "[${RED}FAIL${RESET}] Zsh is not installed."
  fi

  # Check Git
  if command -v git >/dev/null 2>&1; then
    echo -e "[${GREEN}OK${RESET}] Git is installed."
  else
    echo -e "[${RED}FAIL${RESET}] Git is not installed."
  fi

  # Check Plugins
  if [[ -f "$HOME/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
    echo -e "[${GREEN}OK${RESET}] Autosuggestions plugin found."
  else
    echo -e "[${RED}FAIL${RESET}] Autosuggestions plugin missing."
  fi

  if [[ -f "$HOME/.zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
    echo -e "[${GREEN}OK${RESET}] Syntax Highlighting plugin found."
  else
    echo -e "[${RED}FAIL${RESET}] Syntax Highlighting plugin missing."
  fi
}

menu_cmd() {
  while true; do
    echo -e "\n${CYAN}=== AK SHELL Control Center ===${RESET}"
    echo "1) Manage Themes"
    echo "2) Run Diagnostics (Doctor)"
    echo "3) Show Version"
    echo "4) Exit"
    read -p "Select an option [1-4]: " choice
    
    case "$choice" in
      1) theme_cmd list; read -p "Enter theme name to set (or press Enter to cancel): " t; [[ -n "$t" ]] && theme_cmd set "$t" ;;
      2) doctor_cmd ;;
      3) echo "AK SHELL v0.1.0" ;;
      4) echo "Goodbye!"; exit 0 ;;
      *) echo -e "${RED}Invalid option.${RESET}" ;;
    esac
  done
}

# ── Main Routing ───────────────────────────────────────
case "$1" in
  theme) shift; theme_cmd "$@" ;;
  doctor) doctor_cmd ;;
  version) echo "AK SHELL v0.1.0" ;;
  help|--help|-h) show_help ;;
  "") menu_cmd ;;
  *) echo -e "${RED}Unknown command: $1${RESET}"; show_help; exit 1 ;;
esac
